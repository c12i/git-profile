#!/usr/bin/env bash
# git-profile: switch git identities, with per-directory overrides.
#
# Profiles live in ~/.config/git-profile/profiles.gitconfig (override with GIT_PROFILE_CONFIG),
# in git config format, read and written with `git config -f`. The tool renders them into
# ~/.config/git-profile/generated.gitconfig, which ~/.gitconfig includes last, so git itself
# does the switching (any shell, editor or agent harness):
#
#   1. repo-local user.* (set by `use --local`)      highest
#   2. includeIf "gitdir:<dir>/" for assigned dirs
#   3. the active profile                            lowest
#
# Bash 3.2 compatible (macOS default); needs only git.

set -euo pipefail

CONFIG="${GIT_PROFILE_CONFIG:-$HOME/.config/git-profile/profiles.gitconfig}"
STATE_DIR="$(dirname "$CONFIG")"
GENERATED="$STATE_DIR/generated.gitconfig"
PROFILE_DIR="$STATE_DIR/profiles"
GLOBAL_GITCONFIG="$HOME/.gitconfig"
USER_KEYS="name email signingkey"

die() { echo "git-profile: $*" >&2; exit 1; }

cfg() { git config -f "$CONFIG" "$@"; }

need_config() {
    [[ -f "$CONFIG" ]] || die "no config at $CONFIG (see SKILL.md for the format)"
    [[ -n "$(profiles)" ]] || die "no profiles in $CONFIG"
}

# Profile names, in file order.
profiles() {
    cfg --name-only --get-regexp '^profile\..*\.email$' 2>/dev/null | sed -e 's/^profile\.//' -e 's/\.email$//'
}

has_profile() { profiles | grep -qxF -- "$1"; }

require_profile() {
    has_profile "$1" || die "unknown profile '$1' (have: $(profiles | paste -sd, - | sed 's/,/, /g'))"
}

active() {
    local a
    a=$(cfg git-profile.active 2>/dev/null || true)
    [[ -n "$a" ]] && echo "$a" || profiles | head -n 1
}

# Absolute, symlink-resolved path with a trailing slash (what includeIf gitdir matches against).
norm_dir() {
    local d="${1/#\~/$HOME}"
    if [[ -d "$d" ]]; then d=$(cd "$d" && pwd -P); fi
    echo "${d%/}/"
}

# Write one profile's identity into a gitconfig file.
write_identity() {
    local p="$1" file="$2" k v line
    for k in $USER_KEYS; do
        v=$(cfg "profile.$p.$k" 2>/dev/null || true)
        [[ "$k" == signingkey ]] && v="${v/#\~/$HOME}"
        [[ -n "$v" ]] && git config -f "$file" "user.$k" "$v"
    done
    # SSH key: every git ssh connection in this profile offers only this key.
    v=$(cfg "profile.$p.sshkey" 2>/dev/null || true)
    [[ -n "$v" ]] && git config -f "$file" core.sshCommand "ssh -i '${v/#\~/$HOME}' -o IdentitiesOnly=yes"
    # Extra keys: `gitconfig = <key> <value>`, repeatable (a core.sshCommand here wins over sshkey).
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        git config -f "$file" "${line%% *}" "${line#* }"
    done < <(cfg --get-all "profile.$p.gitconfig" 2>/dev/null || true)
}

apply() {
    local act p pf d tmp
    act=$(active)
    has_profile "$act" || die "active profile '$act' is not defined"
    mkdir -p "$PROFILE_DIR"
    tmp=$(mktemp "$STATE_DIR/.generated.XXXXXX")
    printf '# GENERATED by git-profile from %s. Do not edit.\n# active profile: %s\n' "$CONFIG" "$act" > "$tmp"
    write_identity "$act" "$tmp"
    while IFS= read -r p; do
        pf="$PROFILE_DIR/$p.gitconfig"
        printf '# GENERATED by git-profile: profile %s\n' "$p" > "$pf"
        write_identity "$p" "$pf"
        while IFS= read -r d; do
            [[ -z "$d" ]] && continue
            git config -f "$tmp" "includeIf.gitdir:$(norm_dir "$d").path" "$pf"
        done < <(cfg --get-all "profile.$p.dir" 2>/dev/null || true)
    done < <(profiles)
    mv "$tmp" "$GENERATED"
}

# Effective identity in a dir, matched back to a profile by email (+ name when set).
# Prints: profile<TAB>name<TAB>email
resolve() {
    local dir="$1" name email p pe pn
    email=$(git -C "$dir" config user.email 2>/dev/null || true)
    name=$(git -C "$dir" config user.name 2>/dev/null || true)
    while IFS= read -r p; do
        pe=$(cfg "profile.$p.email")
        pn=$(cfg "profile.$p.name" 2>/dev/null || true)
        if [[ "$pe" == "$email" && ( -z "$pn" || "$pn" == "$name" ) ]]; then
            printf '%s\t%s\t%s\n' "$p" "$name" "$email"
            return
        fi
    done < <(profiles)
    printf '\t%s\t%s\n' "$name" "$email"
}

# Switch gh's active account when the profile names one and gh knows it.
gh_switch() {
    local u
    u=$(cfg "profile.$1.gh" 2>/dev/null || true)
    [[ -n "$u" ]] || return 0
    command -v gh >/dev/null 2>&1 || { echo "gh not installed; skipped gh account switch" >&2; return 0; }
    if gh auth switch --hostname github.com --user "$u" >/dev/null 2>&1; then
        echo "gh account: $u"
    else
        echo "gh: account '$u' is not logged in; run: gh auth login" >&2
    fi
}

# gh account of the profile in effect in a dir (empty when none). Used by the gh wrapper.
cmd_gh-user() {
    local dir="$PWD" p
    [[ "${1:-}" == "--dir" ]] && dir="$2"
    need_config
    p=$(resolve "$dir" | cut -f1)
    [[ -n "$p" ]] && cfg "profile.$p.gh" 2>/dev/null || true
}

# Drop a dir from every profile.
remove_dir() {
    local target p d kept
    target=$(norm_dir "$1")
    while IFS= read -r p; do
        kept=()
        while IFS= read -r d; do
            [[ -n "$d" && "$(norm_dir "$d")" != "$target" ]] && kept+=("$d")
        done < <(cfg --get-all "profile.$p.dir" 2>/dev/null || true)
        cfg --unset-all "profile.$p.dir" 2>/dev/null || true
        for d in ${kept[@]+"${kept[@]}"}; do cfg --add "profile.$p.dir" "$d"; done
    done < <(profiles)
}

cmd_list() {
    local cur act p flags d
    need_config
    cur=$(resolve "$PWD" | cut -f1)
    act=$(active)
    while IFS= read -r p; do
        flags=" "; [[ "$p" == "$cur" ]] && flags="*"
        [[ "$p" == "$act" ]] && flags="${flags}A" || flags="${flags} "
        printf '%s %-12s %-16s %-28s %s\n' "$flags" "$p" "$(cfg "profile.$p.name" 2>/dev/null || true)" "$(cfg "profile.$p.email")" \
            "$(u=$(cfg "profile.$p.gh" 2>/dev/null) && echo "gh:$u ")$(k=$(cfg "profile.$p.sshkey" 2>/dev/null) && echo "ssh:$k")"
        while IFS= read -r d; do
            [[ -n "$d" ]] && echo "      dir: $d"
        done < <(cfg --get-all "profile.$p.dir" 2>/dev/null || true)
    done < <(profiles)
    printf '\n* = in effect here, A = active (global) profile\n'
}

cmd_current() {
    local dir="$PWD" short=0 p name email source
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir) dir="$2"; shift 2 ;;
            --short) short=1; shift ;;
            *) die "current: unknown option $1" ;;
        esac
    done
    need_config
    IFS=$'\t' read -r p name email < <(resolve "$dir")
    if [[ $short == 1 ]]; then
        if [[ -n "$p" ]]; then echo "$p"; elif [[ -n "$email" ]]; then echo "?$email"; fi
        return
    fi
    source="dir override / active profile"
    git -C "$dir" config --local user.email >/dev/null 2>&1 && source="repo-local"
    printf 'profile: %s\nname:    %s\nemail:   %s\nsource:  %s\n' "${p:-(unknown)}" "$name" "$email" "$source"
    [[ -n "$p" ]] && cfg "profile.$p.gh" >/dev/null 2>&1 && printf 'gh:      %s\n' "$(cfg "profile.$p.gh")"
    [[ -n "$p" ]] && cfg "profile.$p.sshkey" >/dev/null 2>&1 && printf 'ssh key: %s\n' "$(cfg "profile.$p.sshkey")"
    return 0
}

cmd_use() {
    local p="" local=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --local) local=1; shift ;;
            -*) die "use: unknown option $1" ;;
            *) p="$1"; shift ;;
        esac
    done
    [[ -n "$p" ]] || die "usage: git-profile use <profile> [--local]"
    need_config
    require_profile "$p"
    if [[ $local == 1 ]]; then
        git rev-parse --git-dir >/dev/null 2>&1 || die "--local needs to run inside a git repo"
        # Same identity, ssh key and extra keys as the profile, written into this repo's own config.
        write_identity "$p" "$(git rev-parse --git-path config)"
        echo "this repo now uses '$p' ($(cfg "profile.$p.email"))"
        return
    fi
    cfg git-profile.active "$p"
    apply
    echo "active profile: $p ($(cfg "profile.$p.email")); assigned dirs keep their own profile"
    gh_switch "$p"
}

cmd_unlocal() {
    local k
    for k in $USER_KEYS; do git config --local --unset "user.$k" 2>/dev/null || true; done
    # Only the sshCommand git-profile writes; a hand-set one stays.
    git config --local core.sshCommand 2>/dev/null | grep -q 'IdentitiesOnly=yes' && git config --local --unset core.sshCommand
    echo "removed repo-local identity; dir overrides / active profile apply again"
}

cmd_assign() {
    [[ $# -ge 2 ]] || die "usage: git-profile assign <profile> <dir>..."
    local p="$1" d; shift
    need_config
    require_profile "$p"
    for d in "$@"; do
        remove_dir "$d"
        cfg --add "profile.$p.dir" "$d"
    done
    apply
    echo "assigned to '$p': $*"
}

cmd_unassign() {
    [[ $# -ge 1 ]] || die "usage: git-profile unassign <dir>..."
    local d
    need_config
    for d in "$@"; do remove_dir "$d"; done
    apply
    echo "unassigned: $*"
}

cmd_add() {
    [[ $# -ge 1 ]] || die "usage: git-profile add <name> --name N --email E [--signingkey K]"
    local p="$1"; shift
    [[ "$p" =~ ^[A-Za-z0-9_-]+$ ]] || die "profile names use letters, digits, - and _"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name|--email|--signingkey|--gh|--sshkey) cfg "profile.$p.${1#--}" "$2"; shift 2 ;;
            *) die "add: unknown option $1" ;;
        esac
    done
    if ! cfg "profile.$p.name" >/dev/null || ! cfg "profile.$p.email" >/dev/null; then
        cfg --remove-section "profile.$p" 2>/dev/null || true
        die "a new profile needs --name and --email"
    fi
    apply
    echo "saved profile '$p'"
}

cmd_remove() {
    [[ $# -eq 1 ]] || die "usage: git-profile remove <name>"
    need_config
    require_profile "$1"
    [[ "$1" != "$(active)" ]] || die "cannot remove the active profile; \`use\` another first"
    cfg --remove-section "profile.$1"
    rm -f "$PROFILE_DIR/$1.gitconfig"
    apply
    echo "removed profile '$1'"
}

# Read-only health check of each profile against GitHub.
cmd_check() {
    local p want key who="" sk real_gh
    need_config
    real_gh=$(command -v gh 2>/dev/null || true)
    [[ $# -gt 0 ]] || set -- $(profiles)
    for p in "$@"; do
        require_profile "$p"
        want=$(cfg "profile.$p.gh" 2>/dev/null || true)
        echo "$p:"
        key=$(cfg "profile.$p.sshkey" 2>/dev/null || true)
        if [[ -n "$key" ]]; then
            key="${key/#\~/$HOME}"
            if [[ ! -f "$key" ]]; then
                echo "  ssh:     MISSING key file $key"
            else
                who=$(ssh -T -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=8 -i "$key" git@github.com 2>&1 \
                    | sed -n 's/^Hi \([^!]*\)!.*/\1/p' || true)
                if [[ -z "$who" ]]; then echo "  ssh:     FAIL key not accepted by GitHub"
                else echo "  ssh:     ok, GitHub user $who"; fi
            fi
        else
            echo "  ssh:     no sshkey set (uses ssh config / agent)"
        fi
        if [[ -n "$want" && -n "$real_gh" ]]; then
            if GH_TOKEN= GITHUB_TOKEN= "$real_gh" auth token --hostname github.com --user "$want" >/dev/null 2>&1; then
                echo "  gh:      ok, $want logged in"
            else
                echo "  gh:      NOT LOGGED IN as $want (gh auth login)"
            fi
        fi
        sk=$(cfg "profile.$p.signingkey" 2>/dev/null || git config --global user.signingkey 2>/dev/null || true)
        if [[ -n "$sk" && -n "$who" && -n "$real_gh" && -f "${sk/#\~/$HOME}" ]]; then
            if GH_TOKEN= "$real_gh" api "users/$who/ssh_signing_keys" --jq '.[].key' 2>/dev/null \
                | grep -qF "$(awk '{print $2}' "${sk/#\~/$HOME}")"; then
                echo "  signing: ok, $sk is a signing key on $who"
            else
                echo "  signing: $sk is NOT a signing key on $who (commits show Unverified)"
            fi
        fi
        who=""
    done
}

cmd_apply() {
    need_config
    apply
    echo "wrote $GENERATED"
}

# One-time: include the generated file from ~/.gitconfig, last, so it wins over [user] there.
cmd_init() {
    need_config
    apply
    if ! git config --global --get-all include.path 2>/dev/null | grep -qxF "$GENERATED"; then
        cp -p "$GLOBAL_GITCONFIG" "$GLOBAL_GITCONFIG.bak-git-profile" 2>/dev/null || true
        # user.name/email in ~/.gitconfig would be shadowed anyway; drop them so `git config --global` is not misleading.
        git config --global --unset user.name 2>/dev/null || true
        git config --global --unset user.email 2>/dev/null || true
        printf '\n# git-profile: keep this include LAST\n[include]\n\tpath = %s\n' "$GENERATED" >> "$GLOBAL_GITCONFIG"
    fi
    echo "~/.gitconfig includes $GENERATED; active profile: $(active)"
}

usage() {
    cat <<'EOF'
usage: git-profile <command> [args]

  current [--dir D] [--short]   identity in effect here (default command)
  list                          profiles and their dirs
  use <profile> [--local]       set the active profile, or this repo only
  unlocal                       drop this repo's local identity
  assign <profile> <dir>...     pin dirs to a profile
  unassign <dir>...             unpin dirs
  add <name> --name N --email E [--signingkey K] [--gh GITHUB_USER] [--sshkey KEY]
  check [profile...]            verify each profile's ssh key, gh login and signing key against GitHub
  gh-user [--dir D]             gh account of the profile in effect (used by the gh wrapper)
  remove <name>
  apply                         regenerate git config after editing the config file
  init                          one-time: include the generated config from ~/.gitconfig
EOF
}

cmd="${1:-current}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
    current|list|use|unlocal|assign|unassign|add|remove|apply|init|gh-user|check) "cmd_$cmd" "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 1 ;;
esac
